# =============================================================================
# Athena — Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# --- Elasticsearch (Serverless) ---
ELASTIC_URL=https://your-elasticsearch-endpoint:443
ELASTIC_API_KEY=your-api-key

# --- Obsidian Vault ---
# Local path to your Obsidian vault (used by indexer + Docker volume mount)
VAULT_PATH=/path/to/your/obsidian/vault

# --- Indexer ---
NOTES_INDEX=athena-notes
CONVERSATIONS_INDEX=athena-conversations

# --- MCP Server ---
MCP_SERVER_PORT=8001

# --- Voice (OpenAI Whisper STT + TTS) ---
# Also used by research tools if using OpenAI-compatible services
OPENAI_API_KEY=your-openai-api-key

# --- Research (pick one) ---
# TAVILY_API_KEY=your-tavily-key
# BRAVE_API_KEY=your-brave-key

# --- Voice Client Proxy ---
VOICE_SERVER_PORT=3001
# Uses ELASTIC_URL (derives Kibana URL), ELASTIC_API_KEY, and OPENAI_API_KEY from above

# --- Artemis ---
ARTEMIS_BASE_URL=http://localhost:8000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
CORS_ORIGINS=http://localhost:3000

# --- ngrok (for exposing MCP server to Elastic Cloud) ---
# Get your auth token from https://dashboard.ngrok.com/authtokens
# Claim a free static domain at https://dashboard.ngrok.com/domains
NGROK_AUTHTOKEN=your-ngrok-auth-token
NGROK_DOMAIN=your-subdomain.ngrok-free.dev

# --- Logging ---
LOG_LEVEL=INFO
